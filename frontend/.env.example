# Copy this file to .env.local (or .env) and adjust as needed.
# Never commit an actual .env/.env.local file - only this example is tracked.

# Base URL of the Resume Analyzer backend API.
#
# Left EMPTY (the default) on purpose: with no value, the app calls
# relative paths like "/api/auth/login", and the Vite dev server proxies
# any request starting with /api straight through to the backend (see
# vite.config.js). That keeps the browser's requests same-origin in
# development, which matters because the backend (frozen as of Phase 7)
# does not send CORS headers - a direct cross-origin fetch from the Vite
# dev server's origin to the backend's origin would otherwise be blocked
# by the browser, with no way to fix that from the frontend alone.
#
# Set this explicitly only if the frontend will be served from a
# different origin than the proxy assumes (e.g. a non-default backend
# port, or a built/production deployment served separately from the
# backend). When set, the app calls this URL directly instead of using
# the dev proxy.
VITE_API_BASE_URL=

# Target the Vite dev server proxies /api requests to (development only).
# Defaults to http://localhost:8080 (Spring Boot's default port; the
# backend sets no custom server.port) if left unset - see vite.config.js.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
